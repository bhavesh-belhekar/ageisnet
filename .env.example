# ── AegisNet environment template (copy to .env)
# Host values below work in docker-compose (service names as hostnames).
# For native local dev, point hosts at localhost.

# ── Postgres / TimescaleDB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aegisnet
POSTGRES_PASSWORD=aegisnet
POSTGRES_DB=aegisnet

# ── Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Neo4j
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aegisnet

# ── Backend
BACKEND_PORT=8000

# ── Frontend
FRONTEND_PORT=5173
VITE_BACKEND_WS_URL=ws://localhost:8000/ws/alerts